{
  "schema_version": "LF_PROJECT_CONFIG_V2",
  "project_id": "sandbox",
  "storage": {
    "requests_root": "pilot/runs",
    "registrations_root": "pilot/worker_v08/native_tasks",
    "chain_plans_root": "pilot/orchestrator/chain_plans",
    "task_template_pattern": "pilot/runs/{request}/templates/{task}.task.json"
  },
  "components": {
    "backend": {
      "kind": "maven",
      "root": "apps/time-service",
      "build_file": "apps/time-service/pom.xml",
      "lock_file": null,
      "source_roots": [
        "apps/time-service/src/main/java"
      ],
      "resource_roots": [
        "apps/time-service/src/main/resources"
      ],
      "test_roots": [
        "apps/time-service/src/test",
        "apps/time-service/visible-tests"
      ],
      "migrations_root": "apps/time-service/src/main/resources/db/migration",
      "config_files": [
        "apps/time-service/src/main/resources/application.properties"
      ],
      "generated_client": null
    },
    "frontend": {
      "kind": "npm",
      "root": "frontend",
      "build_file": "frontend/package.json",
      "lock_file": "frontend/package-lock.json",
      "source_roots": [
        "frontend/src"
      ],
      "resource_roots": [],
      "test_roots": [
        "frontend/src"
      ],
      "migrations_root": null,
      "config_files": [],
      "generated_client": {
        "dir": "frontend/src/lib/api/generated",
        "script": "gen:api",
        "generator": "frontend/scripts/gen-api.mjs"
      }
    }
  },
  "areas": {
    "CONTRATO": {
      "write_prefixes": [
        "contracts/"
      ],
      "project_roots": [
        "contracts/"
      ]
    },
    "INFRA": {
      "write_prefixes": [
        "apps/",
        "frontend/"
      ],
      "project_roots": [
        "apps/time-service/",
        "frontend/"
      ]
    },
    "DATA": {
      "write_prefixes": [
        "db/",
        "supabase/migrations/",
        "apps/time-service/src/main/resources/db/migration/"
      ],
      "project_roots": [
        "db/",
        "supabase/migrations/",
        "apps/time-service/src/main/resources/db/migration/"
      ]
    },
    "BACKEND": {
      "write_prefixes": [
        "apps/",
        "backend/"
      ],
      "project_roots": [
        "apps/time-service/src/main/java/",
        "backend/src/main/java/"
      ]
    },
    "FRONTEND": {
      "write_prefixes": [
        "frontend/"
      ],
      "project_roots": [
        "apps/web/",
        "frontend/"
      ]
    }
  },
  "lot_policy": {
    "protected_base": [
      ".github/**",
      ".lf/**",
      "pilot/**",
      "vendor/**",
      "apps/time-service/src/test/**",
      "apps/time-service/visible-tests/**",
      "apps/time-service/pom.xml",
      "apps/time-service/src/main/resources/**",
      "frontend/package.json",
      "frontend/package-lock.json",
      "frontend/src/**/__tests__/**",
      "db/**"
    ],
    "areas": {
      "CONTRATO": {
        "unprotect": [],
        "unprotect_if_written": [],
        "protect": [],
        "context_files": []
      },
      "BACKEND": {
        "unprotect": [],
        "unprotect_if_written": [],
        "protect": [],
        "context_files": []
      },
      "FRONTEND": {
        "unprotect": [],
        "unprotect_if_written": [],
        "protect": [],
        "context_files": []
      },
      "INFRA": {
        "unprotect": [
          "apps/time-service/pom.xml",
          "apps/time-service/src/main/resources/**"
        ],
        "unprotect_if_written": [
          "frontend/package.json",
          "frontend/package-lock.json"
        ],
        "protect": [
          "apps/time-service/src/main/resources/db/**",
          "frontend/src/**",
          "apps/time-service/src/main/java/**"
        ],
        "context_files": [
          "apps/time-service/pom.xml",
          "apps/time-service/src/main/resources/application.properties"
        ]
      },
      "DATA": {
        "unprotect": [
          "apps/time-service/src/main/resources/**",
          "db/**"
        ],
        "unprotect_if_written": [],
        "protect": [
          "apps/time-service/src/main/resources/application.properties",
          "apps/time-service/src/main/resources/static/**",
          "db/**/test/**",
          "db/**/fixtures/**"
        ],
        "context_files": []
      }
    }
  },
  "protected_paths": [
    "apps/time-service/src/test/**",
    "apps/time-service/visible-tests/**",
    "frontend/src/**/__tests__/**"
  ],
  "write_roots": [
    "apps/time-service",
    "apps/web",
    "backend",
    "contracts",
    "db",
    "frontend",
    "pilot/orchestrator/chain_plans",
    "pilot/runs",
    "pilot/worker_v08/native_tasks",
    "supabase/migrations"
  ]
}
