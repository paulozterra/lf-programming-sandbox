{
  "schema_version": "T1_ATOMIZE_RULES_V1",
  "order": [
    "DATA",
    "BACKEND",
    "FRONTEND"
  ],
  "patterns": {
    "DATA": {
      "front_kinds": [
        "DATA_CONTRACT",
        "DATABASE_SCHEMA"
      ],
      "categories": [
        "datos",
        "data",
        "database"
      ],
      "acceptance_regex": "(?i)\\b(migraci[oó]n|tabla|columna|sql|base de datos|check constraint)\\b"
    },
    "BACKEND": {
      "front_kinds": [
        "API_CONTRACT",
        "PERMISSION",
        "SECURITY_PRIVACY",
        "OBSERVABILITY"
      ],
      "categories": [
        "seguridad",
        "security",
        "rate_limiting",
        "api"
      ],
      "acceptance_regex": "(?i)\\b(api|endpoint|bcrypt|token|contrase[nñ]a|autenticar|servidor|http)\\b"
    },
    "FRONTEND": {
      "front_kinds": [
        "UI_VISUAL",
        "UI_INTERACTION"
      ],
      "categories": [
        "interfaz",
        "frontend",
        "ui"
      ],
      "acceptance_regex": "(?i)\\b(pantalla|interfaz|next.js|visual|formulario|bot[oó]n)\\b"
    }
  },
  "routes": {
    "DATA": "apps/{service}/src/main/resources/db/migration/V{next}__{module}.sql",
    "BACKEND": "apps/{service}/src/main/java/lf/sandbox/{service_java}/{module_java}/{class}.java",
    "FRONTEND": [
      "frontend/src/app/{module}/page.tsx",
      "frontend/src/lib/{module}.ts"
    ]
  },
  "service": "time-service",
  "backend_classes": [
    "Controller",
    "Service"
  ],
  "max_paths": 6,
  "project_patterns": {
    "BACKEND": "apps/time-service/src/main/java/",
    "FRONTEND": "frontend/src/",
    "DATA": "apps/time-service/src/main/resources/db/migration/"
  },
  "profile_resolution": {
    "source_ref": "pilot/lf_producers_pinned/selector_experimental/experimental/seed_profiles_exp.sql",
    "project_ref": "lf_java",
    "area_to_profile": {
      "DATA": "PERFIL-PROG-DATA-EXP",
      "BACKEND": "PERFIL-PROG-BACKEND-SPRING-EXP",
      "FRONTEND": "PERFIL-PROG-FRONTEND-EXP",
      "CONTRATO": "PERFIL-PROG-BACKEND-SPRING-EXP",
      "INFRA": "PERFIL-PROG-BACKEND-SPRING-EXP"
    }
  },
  "scope_module_prefixes": [
    "sbx-auth-",
    "demo-",
    "scope-"
  ],
  "contract_lot": {
    "schema_version": "T2_CONTRACT_LOT_POLICY_V1",
    "area": "CONTRATO",
    "write_path": "contracts/{module}.openapi.yaml",
    "profile_area": "BACKEND",
    "depends_on": [
      "CONTRATO"
    ],
    "source_fields": [
      "fields",
      "errors"
    ],
    "semantic_scope_suffixes": [
      "BACKEND",
      "FRONTEND"
    ],
    "max_paths": 1,
    "skeleton_path": "contracts/{module}.skeleton.json"
  },
  "infra_lot": {
    "schema_version": "T3_INFRA_POLICY_V1",
    "area": "INFRA",
    "profile_area": "BACKEND",
    "dependency_allowlist_ref": "pilot/orchestrator/dependency_allowlist_v1.json"
  }
}
