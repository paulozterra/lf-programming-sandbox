  "audit_tasks": [
    {
      "id": "RULE:SBX-R-ERR",
      "description": "Los fallos responden un error genérico indistinguible y la sesión expira a los treinta minutos.",
      "status": "VERIFIED",
      "evidence_refs": [
        "EV-CTRL",
        "EV-AUTH",
        "EV-BE-RUN",
        "EV-ST-RUN"
      ],
      "reason": "INCUMPLE parcial: la sesión expira a los 30 minutos (medido: 200 a los 29, 401 a los 30), pero los fallos no son un error genérico indistinguible: 401 devuelve {error: SBX-E-GENERIC} y 400/404 cuerpo vacío. Además el requisito backend no llegó a ningún lote. Ver F-ERR-NOT-GENERIC y F-ANALYSIS-REQUIREMENTS-WITHOUT-LOT."
    },
    {
      "id": "RULE:SBX-R-LOG",
      "description": "Nunca se registran en los logs la contraseña ni el token de sesión.",
      "status": "VERIFIED",
      "evidence_refs": [
        "EV-CTRL",
        "EV-AUTH",
        "EV-ST-RUN"
      ],
      "reason": "CUMPLE por ausencia: no hay logger ni impresión en el servicio; pero el requisito no se asignó a ningún lote ni se examinó. Ver F-ANALYSIS-REQUIREMENTS-WITHOUT-LOT."
    },
    {
      "id": "RULE:SBX-R-PRIORITY-FILTER",
      "description": "La lista de recordatorios se puede filtrar por prioridad alta, media o baja (HIGH, MEDIUM, LOW) o mostrar todas; un valor distinto responde 400.",
      "status": "VERIFIED",
      "evidence_refs": [
        "EV-CTRL",
        "EV-OAS",
        "EV-BE-RUN"
      ],
      "reason": "CUMPLE parcial: HIGH/MEDIUM/LOW y 'todas' funcionan (medido), y un valor distinto da 400, pero sin el cuerpo GenericError que exige el contrato. Ver F-FILTER-400-BODY."
    },
    {
      "id": "RULE:SBX-R-SESSION-REQUIRED",
      "description": "Solo un usuario con sesión válida puede ver su lista de recordatorios; sin sesión se responde 401 con el error genérico y la pantalla redirige al login.",
      "status": "VERIFIED",
      "evidence_refs": [
        "EV-CTRL",
        "EV-LIB",
        "EV-BE-RUN"
      ],
      "reason": "INCUMPLE: la lista exige sesión, pero sin sesión se puede leer un recordatorio por id, crearlo, posponerlo y borrarlo; y la lista no es 'su' lista: incluye lo creado por anónimos. Ver F-SESSION-ONLY-ON-LIST y F-LIST-NOT-SCOPED-TO-USER."
    }
  ],
