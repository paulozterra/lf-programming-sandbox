      "term_id": "GLOSS-BASE-STATUS-001",
      "term_es": "estado",
      "term_en": "status",
      "plural_en": "statuses",
      "definition": "Situación de una entidad dentro de su ciclo de vida (p. ej. pago aprobado, deuda cerrada).",
      "level": "base",
      "synonyms_es": [],
      "rejected_en": [
        {
          "form": "state",
          "contexts": [
            "database",
            "api"
          ],
          "reason": "En BD y API la situación de negocio es status"
        }
      ],
      "legacy_en": [],
      "contexts": [
        "domain",
        "database",
        "api"
      ],
      "examples": {
        "good": [
          "payment_status"
        ],
        "bad": [
          "payment_state (en BD o API)",
          "estado_pago"
        ]
      },
      "sources": [
        "paulozterra/lf-architecture@bbe718c:docs/requisitos.md#RF-15",
        "paulozterra/lf-architecture@bbe718c:docs/requisitos.md#RF-23",
        "supabase: status en 255 columnas"
      ],
      "decision_ref": "GLOSS-DEC-LF-001",
      "status": "APROBADO",
      "notes": "state se permite para el estado interno de máquinas de estado y del frontend (p. ej. useState); no es alternativa libre a status."
    },
