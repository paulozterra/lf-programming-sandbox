            "jdbc"
          ]
        },
        {
          "form": "debtor",
          "contexts": [
            "domain",
            "database",
            "api"
          ],
          "reason": "Alternativa descartada en el Lote 1"
        }
      ],
      "legacy_en": [
        {
          "form": "client",
          "contracts": [
            "lf_client.client_accounts",
            "lf_client.client_auth_sessions",
            "lf_client.client_phone_bindings",
            "lf_client.client_accounts.client_id",
            "lf_client.client_auth_sessions.client_id",
            "lf_client.client_phone_bindings.client_id",
            "lf_client.onboarding_sessions.client_id",
            "lf_client.security_events.client_id"
          ]
        }
      ],
      "contexts": [
        "domain",
        "database",
        "api"
      ],
      "examples": {
        "good": [
          "customer_id"
        ],
        "bad": [
          "client_id (fuera de los contratos heredados)",
          "deudor_id"
        ]
      },
      "sources": [
        "paulozterra/lf-architecture@bbe718c:docs/requisitos.md#RF-01",
        "paulozterra/lf-architecture@bbe718c:docs/requisitos.md#RF-15"
      ],
      "decision_ref": "GLOSS-DEC-LF-001",
      "status": "APROBADO",
      "notes": "La excepción client vale solo para esos objetos exactos; no autoriza nombres nuevos en el esquema lf_client."
    },
