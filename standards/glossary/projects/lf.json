    {
      "term_id": "GLOSS-LF-COMPANY-001",
      "term_es": "empresa compradora",
      "term_en": "company",
      "plural_en": "companies",
      "definition": "Empresa que compra cartera y opera en LF; cada una es un tenant aislado.",
      "level": "project",
      "synonyms_es": [
        "empresa"
      ],
      "rejected_en": [
        {
          "form": "tenant",
          "contexts": [
            "domain",
            "api"
          ],
          "reason": "tenant es el concepto técnico de aislamiento (RLS, autorización), no la entidad"
        },
        {
          "form": "organization",
          "contexts": [
            "domain",
            "database",
            "api"
          ],
          "reason": "Alternativa descartada en el Lote 1"
        }
      ],
      "legacy_en": [
        {
          "form": "empresas",
          "contracts": [
            "lf_ops.empresas"
          ]
        },
        {
          "form": "empresa",
          "contracts": [
            "lf_ops.empresa_usuarios",
            "lf_ops.empresa_usuarios_perfiles",
            "lf_ops.empresa_usuarios_permisos"
          ]
        }
      ],
      "contexts": [
        "domain",
        "database",
        "api"
      ],
      "examples": {
        "good": [
          "company_id"
        ],
        "bad": [
          "tenant_id como entidad de negocio",
          "empresa_id"
        ]
      },
      "sources": [
        "paulozterra/lf-architecture@bbe718c:docs/requisitos.md#RF-05",
        "supabase: company en 15 columnas y 5 tablas"
      ],
      "decision_ref": "GLOSS-DEC-LF-001",
      "status": "APROBADO",
      "notes": "tenant se reserva para aislamiento multi-tenant, autorización y partición lógica (en BD sí se permite, p. ej. políticas RLS)."
    },
    {
      "term_id": "GLOSS-LF-CUSTOMER-001",
